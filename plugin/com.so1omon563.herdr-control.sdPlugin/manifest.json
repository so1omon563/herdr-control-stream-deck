{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "Icon": "images/action-open",
      "Name": "Herdr Control",
      "PropertyInspectorPath": "property-inspector.html",
      "States": [
        {
          "Image": "images/idle",
          "Name": "Open Herdr"
        },
        {
          "Image": "images/attached",
          "Name": "Return to Herdr"
        }
      ],
      "UUID": "com.so1omon563.herdr-control.toggle"
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "images/action-command",
      "Name": "Herdr Command",
      "PropertyInspectorPath": "property-inspector.html",
      "States": [
        {
          "Image": "images/command",
          "TitleAlignment": "bottom"
        }
      ],
      "UUID": "com.so1omon563.herdr-control.command"
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "images/back",
      "Name": "Return to Previous Profile",
      "States": [
        {
          "Image": "images/back",
          "TitleAlignment": "bottom"
        }
      ],
      "UUID": "com.so1omon563.herdr-control.back",
      "VisibleInActionsList": false
    },
    {
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "Icon": "images/command",
        "layout": "layouts/herdr-dial.json",
        "StackColor": "#2f9dad",
        "TriggerDescription": {
          "Rotate": "Navigate",
          "Push": "Primary action"
        }
      },
      "Icon": "images/command",
      "Name": "HERDR Dial",
      "PropertyInspectorPath": "property-inspector.html",
      "States": [
        {
          "Image": "images/command"
        }
      ],
      "UUID": "com.so1omon563.herdr-control.encoder",
      "VisibleInActionsList": false
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "images/agents",
      "Name": "HERDR Agent",
      "States": [
        {
          "Image": "images/agents",
          "TitleAlignment": "bottom"
        }
      ],
      "UUID": "com.so1omon563.herdr-control.agent",
      "VisibleInActionsList": false
    }
  ],
  "Author": "so1omon563",
  "Category": "Herdr Control",
  "CategoryIcon": "images/category",
  "CodePath": "plugin",
  "Description": "Open or return to Herdr in Ghostty, kitty, iTerm2, or Terminal.app and automatically show the bundled Stream Deck or Stream Deck + controls while it is focused.",
  "Icon": "images/plugin",
  "Name": "Herdr Control",
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Profiles": [
    {
      "AutoInstall": true,
      "DeviceType": 0,
      "DontAutoSwitchWhenInstalled": true,
      "Name": "profiles/HERDR",
      "Readonly": false
    },
    {
      "AutoInstall": true,
      "DeviceType": 7,
      "DontAutoSwitchWhenInstalled": true,
      "Name": "profiles/HERDR Plus",
      "Readonly": false
    }
  ],
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "UUID": "com.so1omon563.herdr-control",
  "Version": "0.1.1.0"
}